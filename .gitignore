# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
studio/node_modules/
studio/dist/
studio/.sanity/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated static storefront staging
/.static-site/

# Local verification screenshots and tool caches
/catalog-preview.png
/catalog-grid-preview.png
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Keep the backend setup template, not real environment files
!backend/.env.example
