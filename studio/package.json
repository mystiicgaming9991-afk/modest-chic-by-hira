  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@oclif/core": { "minimatch": "11.0.3" },
    "undici": "7.30.1"
